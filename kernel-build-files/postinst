#!/bin/bash
set -e

# 1. Determine Kernel Version
# Debian kernel maintainer scripts are called as `postinst <action> <version>`;
# $1 is the kernel release (e.g. 7.3.3-krjy). The package Version field is NOT
# a kernel release (it is 7.3.3-3 here), so never use it for file names.
KVER="${1:-}"
if [ -z "$KVER" ]; then
    KVER="${DPKG_MAINTSCRIPT_PACKAGE#linux-image-}"
fi

if [ -z "$KVER" ]; then
    echo "Error: Could not determine kernel version." >&2
    exit 1
fi

# Skip non-configure actions (abort-upgrade, remove, ...).
if [ -n "${DEB_MAINT_PARAMS-}" ]; then
    eval set -- "$DEB_MAINT_PARAMS"
    if [ -n "${1-}" ] && [ "$1" != "configure" ]; then
        exit 0
    fi
fi

# 2. Dynamically determine Root Partition Label
ROOT_LABEL="linux"
if command -v findmnt >/dev/null 2>&1 && command -v lsblk >/dev/null 2>&1; then
    DETECTED_LABEL=$(lsblk -no PARTLABEL "$(findmnt -no SOURCE / 2>/dev/null)" 2>/dev/null || true)
    if [ -n "$DETECTED_LABEL" ]; then
        ROOT_LABEL="$DETECTED_LABEL"
    fi
fi

# 3. Format the EFI filename and command line
CLEAN_KVER="${KVER//-xiaomi-nabu-tmm/}"
OUTPUT_EFI="${CLEAN_KVER}.efi"
OUTPUT_PATH="/boot/${OUTPUT_EFI}"
CMDLINE="root=PARTLABEL=$ROOT_LABEL rw fw_devlink=permissive"

BOOT_DIR="/boot"
KERNEL_IMG="$BOOT_DIR/vmlinuz-$KVER"
DTB_FILE="$BOOT_DIR/dtb-$KVER"

UKIFY_BIN=$(command -v ukify || true)

# 4. Print full details in the requested format
echo "Post-install: Generating UKI..."
echo " - Kernel:  $KERNEL_IMG"
echo " - DTB:     $DTB_FILE"
echo " - Output:  $OUTPUT_EFI"
echo " - Cmdline: $CMDLINE"

# 5. Build Unified Kernel Image (UKI)
if [ -f "$KERNEL_IMG" ] && [ -n "$UKIFY_BIN" ]; then
    UKIFY_ARGS=(
        build
        --linux "$KERNEL_IMG"
        --cmdline "$CMDLINE"
        --uname "$KVER"
        --output "$OUTPUT_PATH"
    )

    if [ -f "$DTB_FILE" ]; then
        UKIFY_ARGS+=(--devicetree "$DTB_FILE")
    fi

    if [ -f "$BOOT_DIR/initrd.img-$KVER" ]; then
        echo " - Initrd:  $BOOT_DIR/initrd.img-$KVER"
        UKIFY_ARGS+=(--initrd "$BOOT_DIR/initrd.img-$KVER")
    fi

    "$UKIFY_BIN" "${UKIFY_ARGS[@]}"
elif [ ! -f "$KERNEL_IMG" ]; then
    echo "Error: kernel image $KERNEL_IMG not found." >&2
    exit 1
else
    echo "Notice: ukify not found. Skipping UKI generation." >&2
    exit 0
fi

# 6. Attempt to copy UKI to ESP (mounted or via partition)
COPIED=false

if mountpoint -q /boot/efi 2>/dev/null; then
    mkdir -p "/boot/efi/EFI/Ubuntu"
    cp "$OUTPUT_PATH" "/boot/efi/EFI/Ubuntu/"
    sync "/boot/efi/EFI/Ubuntu/$OUTPUT_EFI" 2>/dev/null || true
    echo "Success: $OUTPUT_EFI copied to mounted ESP (/boot/efi/EFI/Ubuntu/)."
    COPIED=true
fi

if [ "$COPIED" = false ]; then
    ESP_PART=""
    for cand in /dev/disk/by-partlabel/esp /dev/disk/by-partlabel/cust /dev/block/by-name/cust /dev/disk/by-partlabel/ESPNABU /dev/disk/by-label/ESPNABU /dev/disk/by-label/esp /dev/sda31; do
        if [ -b "$cand" ]; then
            ESP_PART="$cand"
            break
        fi
    done

    if [ -n "$ESP_PART" ]; then
        MNT_TMP=$(mktemp -d)
        DEST_DIR="$MNT_TMP/EFI/Ubuntu"
        for i in 1 2 3; do
            echo "Attempt $i: Mounting ESP ($ESP_PART)..."
            if mount "$ESP_PART" "$MNT_TMP" 2>/dev/null; then
                mkdir -p "$DEST_DIR"
                cp "$OUTPUT_PATH" "$DEST_DIR/"
                sync "$DEST_DIR/$OUTPUT_EFI" 2>/dev/null || true
                echo "Success: $OUTPUT_EFI copied to ESP ($DEST_DIR/)."
                umount "$MNT_TMP"
                COPIED=true
                break
            fi
            sleep 1
        done
        rm -rf "$MNT_TMP"
    fi
fi

if [ "$COPIED" = false ]; then
    echo "Notice: ESP not available or mount failed. UKI kept at $OUTPUT_PATH"
fi

# 7. Cleanup
# The UKI is written to /boot, so there is nothing to remove here.

exit 0
