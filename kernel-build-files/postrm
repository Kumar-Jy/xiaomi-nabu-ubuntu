#!/bin/bash
set -e

# 1. Only run during actual removal, not during upgrades
if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then

    # 2. Determine Kernel Version
    KVER="$2"
    if [ -z "$KVER" ]; then
        KVER=$(uname -r)
    fi

    # 3. Format the EFI filename
    CLEAN_KVER="${KVER//-xiaomi-nabu-tmm/}"
    TARGET_EFI="${CLEAN_KVER}.efi"

    # Also clean from /boot
    rm -f "/boot/$TARGET_EFI" "/boot/dtb-$KVER" 2>/dev/null || true

    # 4. Remove from mounted /boot/efi
    if mountpoint -q /boot/efi 2>/dev/null; then
        rm -f "/boot/efi/EFI/Ubuntu/$TARGET_EFI" 2>/dev/null || true
    fi

    # 5. Attempt to find and mount ESP
    ESP_PART=""
    for cand in /dev/disk/by-partlabel/esp /dev/disk/by-partlabel/ESPNABU /dev/disk/by-label/ESPNABU /dev/disk/by-label/esp /dev/sda31; do
        if [ -b "$cand" ]; then
            ESP_PART="$cand"
            break
        fi
    done

    if [ -n "$ESP_PART" ]; then
        MNT_TMP=$(mktemp -d)
        DEST_FILE="$MNT_TMP/EFI/Ubuntu/$TARGET_EFI"
        if mount "$ESP_PART" "$MNT_TMP" 2>/dev/null; then
            if [ -f "$DEST_FILE" ]; then
                echo "Post-remove: Deleting $TARGET_EFI from ESP ($ESP_PART)..."
                rm -f "$DEST_FILE"
            fi
            umount "$MNT_TMP"
        fi
        rm -rf "$MNT_TMP"
    fi
fi

exit 0
